<?xml version="1.0" encoding="utf-8"?>
<!-- In-app browser tab: page on top, Firefox-style toolbar at the bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browserOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/browserContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/browserBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tab_bar"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/browserProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:indeterminate="false"
            android:max="100"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/browserClose"
                style="@style/TabBarButton"
                android:contentDescription="@string/browser_close"
                android:src="@drawable/ic_close"
                android:tooltipText="@string/browser_close" />

            <LinearLayout
                android:id="@+id/browserTitleBlock"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_title_block"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/browserTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/browserLock"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/browser_secure"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/browserDomain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/browserShare"
                style="@style/TabBarButton"
                android:contentDescription="@string/browser_share"
                android:src="@drawable/ic_share"
                android:tooltipText="@string/browser_share" />

            <ImageButton
                android:id="@+id/browserMenu"
                style="@style/TabBarButton"
                android:contentDescription="@string/browser_more"
                android:src="@drawable/ic_more_vert"
                android:tooltipText="@string/browser_more" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
