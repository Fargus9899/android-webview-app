<?xml version="1.0" encoding="utf-8"?>
<!-- Theme picker: dimmed background + bottom sheet -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/themeSheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:id="@+id/themeScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/themeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_sheet_handle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/theme_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/theme_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/optionSystem"
                    style="@style/ThemeOption"
                    android:contentDescription="@string/theme_system">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/preview_system" />

                        <ImageView
                            android:id="@+id/checkSystem"
                            style="@style/ThemeOptionCheck" />
                    </FrameLayout>

                    <TextView
                        style="@style/ThemeOptionLabel"
                        android:text="@string/theme_system" />
                </LinearLayout>
                <Space android:layout_width="12dp" android:layout_height="0dp" />
                <LinearLayout
                    android:id="@+id/optionLight"
                    style="@style/ThemeOption"
                    android:contentDescription="@string/theme_light">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/preview_light" />

                        <ImageView
                            android:id="@+id/checkLight"
                            style="@style/ThemeOptionCheck" />
                    </FrameLayout>

                    <TextView
                        style="@style/ThemeOptionLabel"
                        android:text="@string/theme_light" />
                </LinearLayout>
                <Space android:layout_width="12dp" android:layout_height="0dp" />
                <LinearLayout
                    android:id="@+id/optionDark"
                    style="@style/ThemeOption"
                    android:contentDescription="@string/theme_dark">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/preview_dark" />

                        <ImageView
                            android:id="@+id/checkDark"
                            style="@style/ThemeOptionCheck" />
                    </FrameLayout>

                    <TextView
                        style="@style/ThemeOptionLabel"
                        android:text="@string/theme_dark" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/theme_system_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
